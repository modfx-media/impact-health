# Copy to .env.local and fill in. Never commit real values.

# Production origin, used by metadataBase, sitemap.ts and robots.ts.
NEXT_PUBLIC_SITE_URL=https://impacthealthoh.com

# Public origin for Payload serverURL / CSRF.
# Local: http://localhost:3000
# Vercel Production / Preview: the public https origin (never localhost).
NEXT_PUBLIC_SERVER_URL=https://impacthealthoh.com

# Payload CMS (same Next.js app). Generate local secrets; do not reuse
# localhost NEXT_PUBLIC_SERVER_URL on Vercel.
PAYLOAD_SECRET=
# Neon pooled connection string (*-pooler.*). Direct 5432 often times out.
DATABASE_URL=
# Optional direct (unpooled) Neon URL. Prefer the pooled DATABASE_URL above.
DATABASE_URL_UNPOOLED=
PREVIEW_SECRET=
# Optional. Without this, local /media uploads 404 in production on Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional local admin bootstrap (scripts/cms/ensure-admin-user.ts).
# CMS_ADMIN_EMAIL=
# CMS_ADMIN_PASSWORD=

# Areas We Serve feature flags (see lib/areas-we-serve/config.ts).
AREAS_WE_SERVE_ENABLED=false
AREAS_WE_SERVE_PILOT_MODE=false

# Google Places API (New) — powers the 5-star review section.
# Server-only. Never expose this as NEXT_PUBLIC_ and never call Places
# from the browser. The key needs Places API (New) enabled and should be
# restricted to it. GOOGLE_API_KEY is accepted as a fallback name.
GOOGLE_PLACES_API_KEY=

# Place ID for this client's listing only. Impact Health & Wellness,
# 193 W Schrock Rd, Westerville OH: ChIJ5-6sOzf1OIgRDhyieRQ1lEI
GOOGLE_PLACE_ID=
